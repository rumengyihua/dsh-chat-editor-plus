{
  "name": "dsh-chat-editor-plus",
  "version": "0.2.27",
  "description": "Rewrite or delete what the model remembers: the text, reasoning blocks or tool results of any message the model reads, plus one-click clearing of a whole turn, while the message keeps its place and seq on the session surface. Reversible — disable the plugin and the original conversation is back. Branch from any turn. Desktop build of dsh-chat-editor.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumengyihua/dsh-chat-editor-plus.git"
  },
  "homepage": "https://github.com/rumengyihua/dsh-chat-editor-plus#readme",
  "bugs": {
    "url": "https://github.com/rumengyihua/dsh-chat-editor-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation",
    "chat-editor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
