{
  "name": "dsh-chat-editor-plus",
  "version": "0.2.5",
  "description": "Edit, delete or fold any message of a DeepSeek Harness conversation — the user's own and the assistant's. User edits, assistant edits, tool-result edits and deletions rewrite what the model sees through the core's message projection (no placeholder, no correction prefix, thinking kept for assistant replies, and editable in the panel); plus display-only folds and fork. Desktop-adapted fork of dsh-chat-editor from DSH-CyberWorkStation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumengyihua/dsh-chat-editor-plus.git"
  },
  "homepage": "https://github.com/rumengyihua/dsh-chat-editor-plus#readme",
  "bugs": {
    "url": "https://github.com/rumengyihua/dsh-chat-editor-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-cyberworkstation",
    "chat-editor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
